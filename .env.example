# Copy this file to .env.local and change the values you need.
#   macOS / Linux : cp .env.example .env.local
#   PowerShell    : Copy-Item .env.example .env.local
# Restart `npm run dev` after every change. Variables must start with
# NEXT_PUBLIC_ to be readable in the browser.

# true  = use the built-in mock API (data kept in the browser). No backend needed.
# false = call the real backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCK=true

# Address of the REST backend. Only used when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
